# GA4 property (numeric ID — not G-B23WLR63LD)
# Find in GA4 → Admin → Property settings → Property ID
GA4_PROPERTY_ID=

# Optional reference label used in the report header
GA4_MEASUREMENT_ID=G-B23WLR63LD

# Absolute path to the Google Cloud service account JSON key
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/tcte-ga4-reporter.json

# Report branding
REPORT_CLIENT_NAME=The Ceylon Tea Experience
REPORT_SITE_URL=https://www.theceylonteaexperience.com

# Email recipient(s)
REPORT_TO=reservations@theceylonteaexperience.com
REPORT_CC=

# SMTP settings (Gmail example below — use an app password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=TCTE Reports <your-email@gmail.com>
