{
  "redirects": [
    {
      "source": "/s/:campaign",
      "destination": "/?utm_source=sms&utm_medium=sms&utm_campaign=:campaign",
      "permanent": false
    },
    {
      "source": "/s/:campaign/",
      "destination": "/?utm_source=sms&utm_medium=sms&utm_campaign=:campaign",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/partners",
      "destination": "/index.html"
    },
    {
      "source": "/partners/",
      "destination": "/index.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/why-you-should-visit-the-ceylon-tea-experience-in-galle",
      "destination": "/blog/why-you-should-visit-the-ceylon-tea-experience-in-galle/index.html"
    },
    {
      "source": "/blog/why-you-should-visit-the-ceylon-tea-experience-in-galle/",
      "destination": "/blog/why-you-should-visit-the-ceylon-tea-experience-in-galle/index.html"
    },
    {
      "source": "/blog/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/partners",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    },
    {
      "source": "/partners/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    },
    {
      "source": "/downloads/partners/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    }
  ]
}
